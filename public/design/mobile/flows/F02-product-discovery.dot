digraph F02 {
  graph [charset="UTF-8", bgcolor="#ffffff", fontname="Noto Sans CJK KR", fontsize=24, fontcolor="#171717", labelloc=t, labeljust=l, pad="0.45", margin="0.20", ranksep="0.80", nodesep="0.55", splines=spline, compound=true, newrank=true, rankdir=TB, label="F02  제품 탐색과 상세 정보\nTransparency. · 현재 모바일 서비스 흐름"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f6f6", color="#6e6e6e", penwidth=1.3, fontname="Noto Sans CJK KR", fontsize=16, fontcolor="#171717", margin="0.22,0.16", width="2.8", height="0.70"];
