    guest [label="회원가입 없이 이용\n로그인 절차 없음", shape="note", style="filled,dashed", fillcolor="#ffffff", color="#a3a3a3", fontsize="14"];
    header [label="모든 화면의 공통 헤더\n테마 전환: 라이트 ↔ 다크\n테마를 바꿔도 현재 화면 유지", shape="note", style="filled,dashed", fillcolor="#ffffff", color="#a3a3a3", fontsize="14"];
