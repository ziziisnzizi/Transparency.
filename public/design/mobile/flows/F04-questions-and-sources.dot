digraph F04 {
  graph [charset="UTF-8", bgcolor="#ffffff", fontname="Noto Sans CJK KR", fontsize=24, fontcolor="#171717", labelloc=t, labeljust=l, pad="0.45", margin="0.20", ranksep="0.80", nodesep="0.55", splines=spline, compound=true, newrank=true, rankdir=TB, label="F04  AI 질문과 근거 확인\nTransparency. · 현재 모바일 서비스 흐름"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f6f6", color="#6e6e6e", penwidth=1.3, fontname="Noto Sans CJK KR", fontsize=16, fontcolor="#171717", margin="0.22,0.16", width="2.8", height="0.70"];
  edge [fontname="Noto Sans CJK KR", fontsize=14, fontcolor="#484848", color="#777777", penwidth=1.15, arrowsize=0.8];
  subgraph cluster_input {
    label="제품 상세의 질문하기 탭"; fontsize=17; color="#d0d0d0"; penwidth=1; style="rounded"; margin=24;
    M10 [label="M10 · 질문하기\nFAQ와 같은 탭에서 시작", shape="oval", fillcolor="#ededed", penwidth="1.8"];
    compose [label="직접 질문 입력 또는 추천 질문\nEnter 전송 / Shift+Enter 줄바꿈", fillcolor="#ffffff"];
    valid [label="1~500자로\n입력했나요?", shape="diamond", style="filled", fillcolor="#ffffff", width="3.15", height="1.10", fontsize="15"];
    inputError [label="빈 질문·길이 안내\n질문 수정", fillcolor="#ffffff"];
    pending [label="질문 전송 / 답변 준비 중\n입력과 추천 질문은 잠시 비활성", fillcolor="#ffffff"];
    cancel [label="요청 취소\n질문을 초안으로 복원", fillcolor="#ffffff"];
    clear [label="대화 지우기\n대화·진행 중 요청 초기화", fillcolor="#ffffff"];
  }
  subgraph cluster_answer {
    label="답변과 연결 상태"; fontsize=17; color="#d0d0d0"; penwidth=1; style="rounded"; margin=24;
    publicDocs [label="해당 제품의 공개 자료 확인\n성분·사용법·시험 자료의 범위", fillcolor="#ffffff"];
    connected [label="자료 범위 안에서\nAI 답변이 가능한가요?", shape="diamond", style="filled", fillcolor="#ffffff", width="3.15", height="1.10", fontsize="15"];
    M11 [label="M11 · Gemini 답변\n답변 문장과 근거 목록 표시"];
    M12 [label="M12 · 제품 자료 답변\nAI 미연결·응답 실패·자료 밖 질문"];
    M13 [label="M13 · 요청 오류\n네트워크·지연·요청 제한 안내"];
    retry [label="다시 시도\n기존 질문 재전송", fillcolor="#ffffff"];
    next [label="이어서 할 일 선택", shape="diamond", style="filled", fillcolor="#ffffff", width="3.15", height="1.10", fontsize="15"];
    memory [label="대화는 제품별로 화면에서만 유지\n새로고침하면 대화 초기화\n등록 자료 답변을 AI 답변과 구분", shape="note", style="filled,dashed", fillcolor="#ffffff", color="#a3a3a3", fontsize="14"];
  }
  subgraph cluster_sources {
    label="선택한 제품의 근거 위치"; fontsize=17; color="#d0d0d0"; penwidth=1; style="rounded"; margin=24;
    sourceChoice [label="표시된 답변 근거 선택", fillcolor="#ffffff"];
    M05 [label="M05 · 제품 정보\n상세 첫 영역으로 스크롤"];
    M07 [label="M07 · 성분·함량\n같은 제품의 해당 탭"];
    M08 [label="M08 · 효능·근거\n같은 제품의 해당 탭"];
    M09 [label="M09 · 사용 안내\n같은 제품의 해당 탭"];
  }
  M10 -> compose;
  compose -> valid [label="전송"];
  valid -> inputError [label="아니요"];
  inputError -> compose [label="수정", style="dashed"];
  valid -> pending [label="예"];
  pending -> cancel [label="요청 취소"];
  cancel -> compose [label="초안 복원", style="dashed"];
  pending -> publicDocs;
  publicDocs -> connected;
  connected -> M11 [label="예 / 정상 답변"];
  connected -> M12 [label="아니요 / 자료로 안내"];
  pending -> M13 [label="요청 자체 실패"];
  M13 -> retry [label="다시 시도"];
  retry -> pending [label="같은 질문", style="dashed"];
  M11 -> next;
  M12 -> next;
  next -> compose [label="추가 질문", style="dashed"];
  next -> clear [label="대화 지우기"];
  clear -> M10 [label="빈 대화", style="dashed"];
  next -> sourceChoice [label="근거가 있으면 열기"];
  sourceChoice -> M05 [label="제품 정보"];
  sourceChoice -> M07 [label="성분·함량"];
  sourceChoice -> M08 [label="효능·근거"];
  sourceChoice -> M09 [label="사용 안내"];
  publicDocs -> memory [style="dashed"];
}
